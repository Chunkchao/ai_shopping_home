{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-shopping-home.local/contracts/homepage-content-schema.json",
  "title": "Homepage Mock Content Contract",
  "type": "object",
  "required": [
    "homePageConfig",
    "navigation",
    "hero",
    "categories",
    "brandStory",
    "contact"
  ],
  "properties": {
    "homePageConfig": {
      "type": "object",
      "required": ["id", "version", "locale", "sections"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "sections": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["key", "enabled", "order", "title"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "enabled": { "type": "boolean" },
              "order": { "type": "integer", "minimum": 0 },
              "title": { "type": "string", "minLength": 1 },
              "subtitle": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "targetType", "target", "priority", "visible"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "targetType": { "type": "string", "enum": ["anchor", "route", "external"] },
          "target": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0 },
          "visible": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "hero": {
      "type": "object",
      "required": [
        "heading",
        "tagline",
        "description",
        "ctaLabel",
        "ctaTarget",
        "mediaType",
        "mediaUrl",
        "mediaAlt"
      ],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "ctaLabel": { "type": "string", "minLength": 1 },
        "ctaTarget": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "mediaUrl": { "type": "string", "minLength": 1 },
        "mediaAlt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "summary",
          "imageUrl",
          "imageAlt",
          "actionLabel",
          "actionTarget"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "imageUrl": { "type": "string", "minLength": 1 },
          "imageAlt": { "type": "string", "minLength": 1 },
          "actionLabel": { "type": "string", "minLength": 1 },
          "actionTarget": { "type": "string", "minLength": 1 },
          "badge": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "brandStory": {
      "type": "object",
      "required": ["title", "paragraphs", "highlightPhrases"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "paragraphs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "highlightPhrases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "detailLink": { "type": "string" }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": ["companyName", "copyright", "phone", "serviceHours", "email"],
      "properties": {
        "companyName": { "type": "string", "minLength": 1 },
        "copyright": { "type": "string", "minLength": 1 },
        "recordNumber": { "type": "string" },
        "phone": { "type": "string", "minLength": 1 },
        "serviceHours": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "label", "url"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["wechat", "wecom", "xiaohongshu", "weibo", "other"]
              },
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "qrImageUrl": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
